# 复制本文件为 .env 后填写，.env 已被 .gitignore 忽略，切勿提交

# ---------- DeepSeek（本项目大模型固定为 deepseek-v4-flash）----------
# langchain-deepseek 默认读取 DEEPSEEK_API_KEY，模型名直接写在各章节 agent 脚本中
DEEPSEEK_API_KEY=sk-xxx

# ---------- 和风天气 ----------
# 和风天气 2026 年起强制使用账号专属 API Host，勿再用公共 devapi 域名
# 专属 Host 在控制台-设置查看：https://console.qweather.com/setting
# 形如 nd65nqh8rv.re.qweatherapi.com，与 Key 一样属身份认证要素，属敏感信息，只写进 .env，切勿提交
QWEATHER_API_HOST=your-own-host.re.qweatherapi.com
QWEATHER_API_KEY=xxx

# ---------- 可选：LangSmith 可观测性（不填则关闭）---------- 
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2-xxx
# LANGCHAIN_PROJECT=langchain-lab