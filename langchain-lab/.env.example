# OpenAI 兼容云 API 配置
# 框架：langchain-openai，用 base_url + key 即可切到各国产模型
# 复制本文件为 .env 后填写，.env 已被 .gitignore 忽略，切勿提交

# 模型服务商基础地址，例如：
#   DeepSeek  https://api.deepseek.com/v1
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi      https://api.moonshot.cn/v1
#   Ollama(本地) http://host.docker.internal:11434/v1
OPENAI_API_BASE=https://api.deepseek.com/v1

# 组织名随意，模型名以各家为准，例如 deepseek-chat
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=deepseek-chat

# ---------- 可选：LangSmith 可观测性（不填则关闭）---------- 
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2-xxx
# LANGCHAIN_PROJECT=langchain-lab